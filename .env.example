# --- Soneium Minato (testnet) ---
SONEIUM_CHAIN_ID=1946
# Public RPC, confirmed live against Soneium's docs. Fine for this dev/demo
# phase; Soneium's own docs say it's rate-limited and not for production —
# swap for a dedicated provider before mainnet.
SONEIUM_RPC_URL=https://rpc.minato.soneium.org/

# --- OP Stack predeploys (confirmed identical on Mainnet & Minato) ---
SONEIUM_SCHEMA_REGISTRY_ADDRESS=0x4200000000000000000000000000000000000020
SONEIUM_EAS_ADDRESS=0x4200000000000000000000000000000000000021

# --- CopySight schema / attester ---
# COPYSIGHT_SCHEMA_UID is filled in after running `npm run register:schema`
# (also recorded in deployments/minato.json once that's created)
COPYSIGHT_SCHEMA_UID=
COPYSIGHT_ATTESTER_ADDRESS=
# DO NOT commit a real key. One key used for both schema registration and
# attesting, per the architect's spec — not a separate deployer key.
COPYSIGHT_ATTESTER_PRIVATE_KEY=
