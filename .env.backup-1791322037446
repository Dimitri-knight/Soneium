# --- CopySight public API (for the demo/test harness only — NOT called
# by the production module itself; the real integration is called
# in-process by CopySight's own backend after ITS OWN analysis runs.
# This is here so we can drive a real end-to-end demo using real
# CopySight analysis output instead of synthetic test fixtures.) ---
# Confirmed against CopySight's own API docs, not assumed: full endpoint
# is {BASE_URL}/verify, auth header is X-API-Key (case-insensitive).
COPYSIGHT_API_BASE_URL=https://api.copysight.ai/v1
COPYSIGHT_API_KEY=cs_live_8fe504a651265391

# --- Database (PostgresBlockchainProofStore — see migrations/) ---
# No local Postgres available to test against in this environment yet —
# InMemoryBlockchainProofStore stays the default until this is set and
# verified. Run `npm run migrate:db` once this is configured.
DATABASE_URL=

# --- Soneium Minato (testnet) ---
SONEIUM_CHAIN_ID=1946
# Public RPC, confirmed live against Soneium's docs. Fine for this dev/demo
# phase; Soneium's own docs say it's rate-limited and not for production —
# swap for a dedicated provider before mainnet.
SONEIUM_RPC_URL=https://rpc.minato.soneium.org/

# --- OP Stack predeploys (confirmed identical on Mainnet & Minato) ---
SONEIUM_SCHEMA_REGISTRY_ADDRESS=0x4200000000000000000000000000000000000020
SONEIUM_EAS_ADDRESS=0x4200000000000000000000000000000000000021

# --- CopySight schema / attester (Minato) ---
# COPYSIGHT_SCHEMA_UID is filled in after running `npm run register:schema`
# (also recorded in deployments/minato.json once that's created)
COPYSIGHT_SCHEMA_UID=
COPYSIGHT_ATTESTER_ADDRESS=
# DO NOT commit a real key. One key used for both schema registration and
# attesting, per the architect's spec — not a separate deployer key.
COPYSIGHT_ATTESTER_PRIVATE_KEY=
# Filled in after running `npm run deploy:resolver`. Leave blank to
# register the schema with no resolver at all (the zero address) — a
# separate, permanent choice, not the same as "not deployed yet".
COPYSIGHT_RESOLVER_ADDRESS=

# --- Soneium Mainnet — NOT used automatically by anything, config only ---
# Chain ID confirmed via Soneium docs: 1868. No default RPC on purpose —
# Soneium's public endpoints are rate-limited and not for production;
# get a dedicated provider before setting this for real.
SONEIUM_MAINNET_CHAIN_ID=1868
SONEIUM_MAINNET_RPC_URL=
COPYSIGHT_MAINNET_SCHEMA_UID=
COPYSIGHT_MAINNET_ATTESTER_ADDRESS=
COPYSIGHT_MAINNET_RESOLVER_ADDRESS=
# DO NOT commit a real key. Deliberately separate from the Minato key
# above (environment separation) — do not reuse a Minato key on Mainnet.
# Consider whether this should be a KMS/HSM-backed signer instead of a
# raw key here before actually going live — see SignerService.ts.
COPYSIGHT_MAINNET_ATTESTER_PRIVATE_KEY=
