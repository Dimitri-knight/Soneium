{
  "name": "copysight-soneium-integration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CopySight x Soneium blockchain integration module - Proof of Creation & IP Validation (Minato sandbox)",
  "scripts": {
    "verify:setup": "tsx scripts/verifyMinatoSetup.ts",
    "deploy:resolver": "tsx scripts/deployCopySightResolver.ts",
    "register:schema": "tsx scripts/registerSoneiumSchema.ts",
    "manage:attester": "tsx scripts/manageAttester.ts",
    "deploy:royalty": "tsx scripts/deployRoyaltyContracts.ts",
    "migrate:db": "tsx scripts/migrateDatabase.ts",
    "demo:flow": "tsx demo/runFullFlow.ts",
    "demo:web": "tsx demo/webServer.ts",
    "demo:local-devnet": "tsx demo/startLocalDevnet.ts",
    "test": "vitest run",
    "test:devnet": "vitest run test/integration/localAnvilDevnet.test.ts --config vitest.devnet.config.ts",
    "test:postgres": "vitest run test/integration/postgresDevnet.test.ts --config vitest.postgres.config.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@ethereum-attestation-service/eas-contracts": "^1.7.1",
    "@ethereum-attestation-service/eas-sdk": "^2.9.1",
    "@openzeppelin/contracts": "^5.6.1",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "pg": "^8.23.0",
    "viem": "^2.55.18"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
